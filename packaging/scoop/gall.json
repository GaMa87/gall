{
    "version": "0.2.2",
    "description": "Keyboard-first file manager: Miller columns, dual pane, instant search, compare tool and Vim keys",
    "homepage": "https://github.com/GaMa87/gall",
    "license": "MIT",
    "notes": [
        "Settings and data are kept in %APPDATA%\\gall and survive updates (create an empty file named portable next to gall.exe to use $persist_dir\\UserData instead).",
        "Gall needs the Microsoft Edge WebView2 Runtime (included in Windows 10 and 11)."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/GaMa87/gall/releases/download/v0.2.2/Gall-0.2.2-windows-x64-portable.zip",
            "hash": "92b5650b93e0aac2aef132737e06af00efbff7d95fccf11b2fddc9a2baf42b50",
            "extract_dir": "Gall-0.2.2-windows-x64-portable"
        }
    },
    "bin": "gall.exe",
    "shortcuts": [
        [
            "gall.exe",
            "Gall"
        ]
    ],
    "persist": "UserData",
    "checkver": {
        "url": "https://api.github.com/repos/GaMa87/gall/releases",
        "jsonpath": "$[0].tag_name",
        "regex": "v([\\w.-]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/GaMa87/gall/releases/download/v$version/Gall-$version-windows-x64-portable.zip",
                "extract_dir": "Gall-$version-windows-x64-portable",
                "hash": {
                    "url": "$baseurl/SHA256SUMS"
                }
            }
        }
    }
}
