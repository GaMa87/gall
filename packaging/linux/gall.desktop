# Static Freedesktop entry (no Handlebars placeholders) so it validates cleanly
# and works identically as tauri-bundler's desktopTemplate and in source packages.
# DBusActivatable is intentionally omitted: gall.desktop is not reverse-DNS
# (which fails desktop-file-validate) and Gall does not implement
# org.freedesktop.Application (GLib gtk-launch skips Exec= without fallback).
# Launching uses Exec=, while D-Bus FileManager1 activation uses
# org.gall.app.FileManager1.service.
[Desktop Entry]
Type=Application
Name=Gall
Comment=Keyboard-first file manager with instant search and compare
