# Maintainer: Matej Gajšek <37571659+GaMa87@users.noreply.github.com>
#
# AUR package "gall-bin": repackages the official .deb from GitHub Releases.
# Bump: set pkgver (pkgrel=1), run `updpkgsums && makepkg --printsrcinfo > .SRCINFO`. The checksums
# below are those of the published v0.3.1 release (`SHA256SUMS`); every release needs new ones.
#
# This package repackages the .deb, whose Gall has no GALL_PACKAGE_MANAGED flag: it updates through the
# signed user-space overlay (the system files under /usr stay as pacman installed them). The source
# package `gall` (packaging/arch/gall) is built with the flag and never self-updates.
#
# App ID / file names that come from the .deb (change when the app ID changes;
# nothing in this PKGBUILD depends on them, they are listed so namcap output makes sense):
#   /usr/share/applications/gall.desktop (normalized from Gall.desktop)
#   /usr/share/metainfo/org.gall.app.metainfo.xml
#   /usr/share/icons/hicolor/*/apps/gall.png
#   /usr/share/icons/hicolor/scalable/apps/gall.svg (0.3.0+)
#   /usr/share/dbus-1/services/org.gall.app.FileManager1.service (0.3.0+)
#   /usr/share/gall/actions.d/50-omarchy.json (0.3.0+)
pkgname=gall-bin
_pkgname=gall
pkgver=0.3.1
pkgrel=1
pkgdesc="Keyboard-first file manager: Miller columns, dual pane, instant search, compare tool and Vim keys"
arch=('x86_64')
url="https://github.com/GaMa87/gall"
license=('MIT')
# From the ELF NEEDED entries of /usr/bin/gall (readelf -d):
#   libwebkit2gtk-4.1, libjavascriptcoregtk-4.1 -> webkit2gtk-4.1
#   libgtk-3, libgdk-3 -> gtk3; libgdk_pixbuf-2.0 -> gdk-pixbuf2; libcairo -> cairo
#   libglib/gobject/gio-2.0 -> glib2; libsoup-3.0 -> libsoup3; libdbus-1 -> dbus
#   libgcc_s -> gcc-libs; libc/libm/ld-linux -> glibc
depends=('cairo'
         'dbus'
         'gcc-libs'
         'gdk-pixbuf2'
         'glib2'
         'glibc'
         'gtk3'
         'hicolor-icon-theme'
         'libsoup3'
         'webkit2gtk-4.1')
optdepends=('gst-plugins-good: video and audio preview'
            'gst-libav: more video formats in the preview'
            'git: Git status in the file list'
            'ttf-nerd-fonts-symbols: Nerd Font file icons')
provides=("$_pkgname")
conflicts=("$_pkgname")
options=('!strip' '!debug')
source=("$url/releases/download/v$pkgver/Gall_${pkgver}_amd64.deb"
        "LICENSE-$pkgver::https://raw.githubusercontent.com/GaMa87/gall/v$pkgver/LICENSE")
sha256sums=('6080cf16f900bca1bd2768d3fc4fae3ee7d5220e0282bcd790b187e495a88237'
            '565441b185f6bf183284cc87c34d43e2084b04d2c94275536b60d2e93eca3ba3')

package() {
  # makepkg unpacks the .deb (ar) into control.tar.gz and data.tar.gz.
  # Future .deb releases (0.3.0+) also ship gall.svg, FileManager1.service, and 50-omarchy.json here.
  bsdtar -xf data.tar.gz -C "$pkgdir" --no-same-owner
  chmod 755 "$pkgdir/usr/bin/$_pkgname"
  if [[ -f "$pkgdir/usr/share/applications/Gall.desktop" && ! -e "$pkgdir/usr/share/applications/gall.desktop" ]]; then
    mv "$pkgdir/usr/share/applications/Gall.desktop" "$pkgdir/usr/share/applications/gall.desktop"
  fi
  if [[ -f "$pkgdir/usr/share/applications/gall.desktop" ]]; then
    sed -i 's/^Icon=.*/Icon=gall/' "$pkgdir/usr/share/applications/gall.desktop"
    if grep -q '^StartupWMClass=' "$pkgdir/usr/share/applications/gall.desktop"; then
      sed -i 's/^StartupWMClass=.*/StartupWMClass=gall/' "$pkgdir/usr/share/applications/gall.desktop"
    else
      printf 'StartupWMClass=gall\n' >> "$pkgdir/usr/share/applications/gall.desktop"
    fi
  fi
  install -Dm644 "LICENSE-$pkgver" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
